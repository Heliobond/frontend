{
  "name": "heliobond-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Heliobond — sunlight made financial. Investor app for a green-bond pool on Stellar.",
  "license": "Apache-2.0",
  "author": "Heliobond (https://heliobond.vercel.app)",
  "homepage": "https://heliobond.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heliobond/frontend.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test --parallel=4",
    "test:coverage": "bun scripts/test-coverage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "CSP_MODE=enforce E2E_PRODUCTION=true playwright test --project=production e2e/security-headers.spec.ts",
    "test:e2e:chain": "playwright test --config playwright.chain.config.ts",
    "bundle:check": "node scripts/check-bundle-size.js",
    "typecheck:coverage": "node scripts/check-type-coverage.mjs",
    "preinstall": "node scripts/require-bun.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.6.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@stellar/stellar-sdk": "^16.3.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@sinonjs/fake-timers": "15.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/bun": "1.4.4",
    "@types/jsdom": "21.1.7",
    "@types/node": "^25.9.3",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "axios": "^1.20.0",
    "browserslist": ">=4.28.7",
    "follow-redirects": ">=1.16.2",
    "launch-editor": ">=2.14.2",
    "nanoid": "^3.3.16",
    "postcss": ">=8.5.23",
    "smol-toml": ">=1.7.1",
    "source-map-js": ">=1.2.2",
    "ws": ">=8.21.0",
    "baseline-browser-mapping": ">=2.11.0",
    "fflate": ">=0.6.11"
  }
}

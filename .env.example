# Copy this file to .env.local for local development.
#
# The app works without any values here: it falls back to fixture/demo data.
# Fill these in when testing against a local API or deployed Soroban vault.

# Backend API (#588). Everything under /v1 requires an API key, and a secret
# must never live in a NEXT_PUBLIC_* variable — Next.js inlines those into the
# client bundle. The browser calls the same-origin /api/backend proxy instead,
# and these two are read on the server only.
# Leave HELIOBOND_API_URL blank to use bundled demo data.
HELIOBOND_API_URL=http://localhost:3001
HELIOBOND_API_KEY=

# Public base URL, used by the browser for the auth endpoints. Prefer
# HELIOBOND_API_URL for server-side calls.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Force demo data even when a backend is configured.
NEXT_PUBLIC_DEMO_MODE=

# Stellar network used by wallet and Soroban helpers: "public" or "testnet".
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional Soroban vault contract ID. Leave blank to keep vault actions in demo mode.
NEXT_PUBLIC_VAULT_CONTRACT_ID=

# Optional RPC/Horizon overrides. Defaults are selected from NEXT_PUBLIC_STELLAR_NETWORK.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Content-Security-Policy rollout (#601). Leave unset for report-only; set to
# "enforce" once the report stream is clean.
CSP_MODE=
# Optional endpoint that receives CSP violation reports.
NEXT_PUBLIC_CSP_REPORT_URI=

# Client error + web-vitals sink (#609). Leave blank to disable remote reporting.
NEXT_PUBLIC_ERROR_REPORT_URL=
# Release/version tag attached to reports.
NEXT_PUBLIC_RELEASE=
# Set to "true" at build time to publish browser source maps for the sink.
SOURCE_MAPS=

# Wallet-signature sign-in (#603). Base URL of the auth endpoints; defaults to
# NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_AUTH_URL=

# Optional WebSocket URL for live vault events.
NEXT_PUBLIC_WS_URL=

# Optional Soroban ProjectRegistry contract ID.
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=

# Optional Admin address for vault/registry.
NEXT_PUBLIC_ADMIN_ADDRESS=

# Set to "true" to force demo mode and use mock data.
NEXT_PUBLIC_DEMO_MODE=

# Set to "true" to enable developer routes.
NEXT_PUBLIC_ENABLE_DEV_ROUTES=

# Overrides the default Stellar network passphrase.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=

# Set to "true" to enable the E2E test wallet (never on mainnet).
NEXT_PUBLIC_E2E_TEST_WALLET=
